APP_NAME=MSEA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
# Zona horaria de MSEA: define cuando empieza el "dia" para rachas, metas y topes diarios.
APP_TIMEZONE=America/La_Paz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily = un archivo por dia, se conservan LOG_DAILY_DAYS dias.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=MSEA
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Produccion (ver DEPLOYMENT.md) -------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# MAIL_MAILER=smtp   (y MAIL_HOST/PORT/USERNAME/PASSWORD reales)

# --- MSEA: datos de demostracion -----------------------------------------
# El seeder MseaDemoSeeder se niega a ejecutarse en produccion salvo que
# MSEA_PERMITIR_DEMO=true. Define una contrasena propia y fuerte.
MSEA_PERMITIR_DEMO=false
MSEA_DIRECTOR_EMAIL=director@msea.test
MSEA_DIRECTOR_PASSWORD=
MSEA_DIRECTOR_NAME=Director
MSEA_DIRECTOR_LASTNAME=MSEA

# --- MSEA: gamificacion (valores por defecto en config/msea.php) ---------
# MSEA_XP_AFINACION=15
# MSEA_XP_RITMO=20
# MSEA_XP_TEORIA_PRACTICA=10
# MSEA_XP_TECNICA=15
# MSEA_XP_LIBRE=10
# MSEA_PRACTICA_MIN_SEGUNDOS=30
# MSEA_XP_TOPE_DIARIO=150
# Dias sin practicar que no cortan la racha (0 = racha estricta).
# MSEA_RACHA_DIAS_DESCANSO=1

# --- MSEA: archivos privados ---------------------------------------------
# MSEA_ARCHIVOS_DISCO=local
# MSEA_AUDIO_MAX_KB=20480
# MSEA_MATERIAL_MAX_KB=15360

# --- MSEA: API movil -------------------------------------------------------
# MSEA_TOKEN_DIAS=30
# MSEA_MAX_SESIONES_MOVILES=5

# --- MSEA: correo ------------------------------------------------------------
# true = los codigos de recuperacion se envian por la cola (requiere
# `php artisan queue:work`). false = envio inmediato.
MSEA_CORREO_EN_COLA=false

# Intentos fallidos de codigo de recuperacion permitidos por correo en 24 h.
# MSEA_RECUPERACION_MAX_DIA=20

# --- MSEA: reversion de migraciones ------------------------------------------
# En produccion `migrate:rollback` esta bloqueado porque borra datos. Ponlo en
# true solo de forma temporal y con una copia de seguridad recien hecha.
MSEA_PERMITIR_ROLLBACK=false

# --- Inicio de sesion con Google (opcional) --------------------------------
# ID de cliente OAuth tipo "Aplicacion web" de Google Cloud (ver README).
# Si se deja vacio, el boton "Continuar con Google" no aparece.
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS_EXTRA=

# Digitalizador de métodos (ver docs/DIGITALIZADOR.md). Vacío = escribir las notas a mano.
MSEA_OMR_AUDIVERIS=
# En produccion conviene true (worker: queue:work database-largo --queue=omr --timeout=3600).
MSEA_OMR_EN_COLA=false

# --- Sitio publico: contacto, legal, SEO, WhatsApp y analitica -----------
# Todo es opcional: lo que quede vacio simplemente no se muestra.
# MSEA_LEGAL_RAZON_SOCIAL="Fundación Movimiento Sinfónico de El Alto"
# MSEA_LEGAL_NIT=
# MSEA_LEGAL_ACTUALIZADO=2026-10-15     # fecha de la ultima revision de los textos legales
# MSEA_CONTACTO_CORREO=
# MSEA_CONTACTO_TELEFONO=
# MSEA_CONTACTO_DIRECCION=
# MSEA_WHATSAPP=                        # solo digitos con codigo de pais, ej. 5917XXXXXXX
# MSEA_WHATSAPP_MENSAJE="Hola, quiero información sobre el Movimiento Sinfónico de El Alto (MSEA)."
# MSEA_RED_FACEBOOK=
# MSEA_RED_INSTAGRAM=
# MSEA_RED_YOUTUBE=
# MSEA_RED_TIKTOK=
# MSEA_FICHA_GOOGLE_URL=                # enlace de la ficha de Google Business Profile
# MSEA_ANALITICA_GA4=                   # ej. G-XXXXXXXXXX (solo carga si la persona acepta)
# MSEA_ANALITICA_PLAUSIBLE=             # alternativa sin cookies: dominio, ej. msea.org.bo
# MSEA_FORZAR_HTTPS=                    # vacio = solo en produccion; true/false para forzar
# MSEA_PROXIES=                         # IP del proxy (Nginx: 127.0.0.1; Cloudflare: sus rangos). Evita "*".
# MSEA_HOSTS=                           # dominios extra aceptados, separados por coma (APP_URL ya se acepta)
# MSEA_ANTISPAM=true                    # campo trampa + tiempo minimo en formularios publicos

